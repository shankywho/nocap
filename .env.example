# ── Mode ────────────────────────────────────────────────
MOCK_EXTERNALS=true            # true = no keys needed: mock LLM, mock GitHub, in-memory store

# ── LLM (open models only) ──────────────────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_MS=20000
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# If the hackathon credit provider differs, point LLM_BASE_URL/LLM_MODEL at it (any OpenAI-compatible endpoint).

# ── Web ─────────────────────────────────────────────────
DATABASE_URL=                  # Neon pooled connection string; empty → in-memory store
DIRECT_URL=                    # Neon direct URL for prisma migrate
GITHUB_TOKEN=                  # fine-grained PAT, public repos read-only (server-side only)
PUBLIC_BASE_URL=http://localhost:3000
PUBLISH_MAX_BYTES=262144
RATE_LIMIT_PUBLISH_PER_HOUR=30
RATE_LIMIT_VERIFY_PER_HOUR=20

# ── CLI ─────────────────────────────────────────────────
NOCAP_API_URL=https://nocap.vercel.app   # where --publish posts
NOCAP_BLOCK=0           # 1 = Stop hook blocks the agent on ✗
NOCAP_TEST_TIMEOUT_MS=120000
NOCAP_OFFLINE=0         # 1 = never call an LLM (regex extractor only)
