{
  "name": "nocap-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/build-fixtures.ts",
    "pack:cli": "node scripts/pack-cli.mjs",
    "build:action": "node scripts/build-action.mjs",
    "e2e": "npm --prefix e2e test",
    "build:art": "node scripts/build-art.mjs",
    "build-log": "sh scripts/build-log.sh",
    "docs:cli": "tsx --tsconfig tsconfig.tools.json scripts/gen-cli-docs.ts",
    "examples:generate": "tsx --tsconfig tsconfig.tools.json scripts/generate-examples.ts",
    "eval": "tsx --tsconfig tsconfig.tools.json scripts/eval.ts",
    "demo": "tsx --tsconfig tsconfig.tools.json scripts/demo.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.2",
    "eslint": "^9.39.5",
    "execa": "^10.2.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
