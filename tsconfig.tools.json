{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@nocap/core": [
        "packages/core/src/index.ts"
      ],
      "@nocap/mcp": [
        "packages/mcp/src/server.ts"
      ],
      "@nocap/core/adapters/web": [
        "packages/core/src/adapters/web.ts"
      ],
      "@nocap/core/adapters": [
        "packages/core/src/adapters/index.ts"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts",
    "action/src/**/*.ts",
    "action/test/**/*.ts",
    "vitest.config.ts"
  ]
}
